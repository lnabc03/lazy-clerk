ADMIN_PASSWORD=            # 管理页密码（首次启动哈希入库，此后仅校验）
SERVERCHAN_SENDKEY=        # 管理员的 Server 酱 SendKey
SESSION_SECRET=            # session cookie 签名密钥（随机长字符串）
TZ=Asia/Shanghai

# ---- 代理逃生通道（可选）：医院封服务器 IP 时启用 ----
# 把下面五行取消注释、填好值后 `docker compose up -d` 即可。
# COMPOSE_PROFILES 让 compose 自动带上 mihomo sidecar——此后 up / restart /
# 升级都不需要任何额外参数。直连优先，直连被封自动切订阅里最快的节点，
# 恢复自动切回。
# COMPOSE_PROFILES=proxy
# PROXY_SUB_URL=             # 机场订阅链接（mihomo proxy-provider，敏感凭据勿外泄）
# MIHOMO_SECRET=             # 节点管理 API 密钥（随机长字符串）
# PROXY_URL=http://mihomo:7890
# MIHOMO_API=http://mihomo:9090
